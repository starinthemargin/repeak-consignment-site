---
import Base from '../layouts/Base.astro';
---
<Base title="RePeak Consignment | Online consignment store | Denver, CO">
  <div class="hero">
    <h1>Discover sustainable fashion</h1>
    <p>Online consignment shop based in Denver, CO.</p>
    <p>Your wardrobe deserves a second peak. 🏔️ We help your pre-loved pieces reach a wider audience than brick &amp; mortar ever could.</p>
    <a class="button" href="#shop">Shop our newest treasures</a>
  </div>
  <section class="wrap">
    <h2>Our story</h2>
    <p>At RePeak Consignment, we are committed to delivering a unique online consignment experience for our buyers and Denver, CO clients. We curate pre-loved apparel, shoes, and accessories, giving buyers affordable and sustainable fashion options.</p>
    <a class="button" href="/about/">Learn more</a>
  </section>
  <section class="wrap" id="shop">
    <h2>Discover our newest treasures</h2>
    <p>Find us on your favorite resale app:</p>
    <div class="platforms">
      <a class="button" href="https://poshmark.com/closet/repeakconsign">Poshmark</a>
      <a class="button" href="https://www.mercari.com/u/repeakconsignment/">Mercari</a>
      <a class="button" href="https://www.depop.com/repeakconsignment/">Depop</a>
    </div>
  </section>
</Base>
