---
import Base from '../layouts/Base.astro';
import Ridge from '../components/Ridge.astro';
import { steps } from '../data/steps';
const email = 'info@repeakconsignment.com';
const checks = [
  'Freshly laundered or dry cleaned',
  'In excellent condition: new and unused, or gently used',
  'Free of stains, holes, and pet hair',
  'In good repair, with no missing buttons or unraveling hems',
  'Not excessively wrinkled',
  'Authentic. No replicas or imitations',
];
---
<Base title="Consign with us | RePeak Consignment">
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Consign</p>
      <h1>Consign with us</h1>
      <p class="lead">Turn your pre-loved pieces into something new. We handle the listing, selling, and shipping.</p>
    </div>
    <Ridge />
  </div>
  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2>Three simple steps</h2>
        <p class="lead">Based in Denver, CO? Here's the big picture.</p>
      </div>
      <ol class="steps">
        {steps.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
      </ol>
    </div>
  </section>
  <section class="tint">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">The details</p>
        <h2>Everything to know before you bring us your pieces</h2>
      </div>

      <div class="detail">
        <h3>What we accept</h3>
        <div>
          <p>We gladly accept women's and men's on-trend, boutique, and designer clothing, footwear, bags, and accessories.</p>
          <p>Please bring only your best items. Aim for pieces that would easily sell for $20 or more. If you don't think someone would pay that, a yard sale or donation may be a better fit.</p>
          <p>Browse our <a href="/brands/">Brands we love</a> list and edit your selection to match.</p>
        </div>
      </div>

      <div class="detail">
        <h3>Condition</h3>
        <div>
          <p>Please pre-inspect everything before you bring it in. Look for stains, holes, pilling, deodorant marks, unraveling hems, and missing buttons, and take the time to clean or repair if needed. Items we receive should be:</p>
          <ul class="checks">
            {checks.map((t) => <li>{t}</li>)}
          </ul>
          <p>Items that don't meet these standards can't be listed, and may be donated or recycled.</p>
        </div>
      </div>

      <div class="detail">
        <h3>Drop-offs</h3>
        <div>
          <p>We're a home-based, online-only shop with limited storage space, so we take on new clients as space allows. Email us to ask about availability.</p>
          <p>Because of the effort it takes to prepare items for listing, please bring no more than <strong>25 items per appointment</strong>.</p>
          <p><strong>Drop &amp; Go for returning clients.</strong> If you've consigned with us before, drop off your items during your scheduled time and go on about your day. Email <a href={`mailto:${email}?subject=Schedule%20a%20Drop%20%26%20Go%20Time`}>{email}</a> to schedule. Drop &amp; Go is limited to 25 items per client, and items should follow the guidelines above.</p>
        </div>
      </div>

      <div class="detail">
        <h3>Consignment period</h3>
        <div>
          <p>Each item stays listed for six months (180 days) from the date it's first listed.</p>
          <p>When items expire, we'll let you know by email, usually along with your monthly statement. You'll have 14 days to arrange a pickup of anything unsold. We don't offer return shipping. Items that aren't picked up in time become ours to donate or recycle.</p>
        </div>
      </div>
    </div>
  </section>
  <section class="dark cta">
    <div class="wrap">
      <div class="section-head">
        <h2>Ready to get started?</h2>
        <p class="lead">Send us a note and we'll take it from there.</p>
      </div>
      <div class="actions"><a class="btn btn-light" href={`mailto:${email}?subject=Consigning%20with%20RePeak`}>Email {email}</a></div>
    </div>
  </section>
</Base>
