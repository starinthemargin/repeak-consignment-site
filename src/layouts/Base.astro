---
import '../styles/global.css';
interface Props { title: string; description?: string }
const { title, description = 'Online consignment shop based in Denver, CO. Your wardrobe deserves a second peak.' } = Astro.props;
const path = Astro.url.pathname;
const platforms = [
  { href: 'https://poshmark.com/closet/repeakconsign', label: 'Poshmark' },
  { href: 'https://www.mercari.com/u/repeakconsignment/', label: 'Mercari' },
  { href: 'https://www.depop.com/repeakconsignment/', label: 'Depop' },
];
const links = [
  { href: '/consign-with-us/', label: 'Consign with us' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site">
      <div class="wrap">
        <a class="brand" href="/"><img src="/logo-white.png" alt="RePeak Consignment" width="120" height="120" /></a>
        <nav>
          {links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer>
      <div class="wrap">
        <p>Denver, CO</p>
        <p>Shop with us: {platforms.map((l, i) => <>{i > 0 && ' · '}<a href={l.href}>{l.label}</a></>)}</p>
        <p>&copy; {new Date().getFullYear()} RePeak Consignment</p>
      </div>
    </footer>
  </body>
</html>
