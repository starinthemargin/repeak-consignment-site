---
import Base from '../layouts/Base.astro';
import Ridge from '../components/Ridge.astro';
const email = 'info@repeakconsignment.com';
---
<Base title="Refund policy | RePeak Consignment">
  <div class="page-head">
    <div class="wrap">
      <p class="eyebrow">Shop</p>
      <h1>Refund policy</h1>
      <p class="lead">Returns &amp; refunds</p>
    </div>
    <Ridge />
  </div>
  <section>
    <div class="wrap prose">
      <p>Due to the nature of consignment, all sales are final and we must maintain a strict no returns and no refunds policy. For this reason, we try our best to photograph and describe the items, including measurements, as accurately as possible, as it is important to us that you know you love the item and that it will work for you before you purchase it.</p>
      <p>If you have any questions or concerns, please <a href={`mailto:${email}`}>contact us</a>.</p>
    </div>
  </section>
</Base>
