---
import Base from '../layouts/Base.astro';
import Ridge from '../components/Ridge.astro';
const shops = [
  { name: 'Poshmark', href: 'https://poshmark.com/closet/repeakconsign' },
  { name: 'Mercari', href: 'https://www.mercari.com/u/repeakconsignment/' },
  { name: 'Depop', href: 'https://www.depop.com/repeakconsignment/' },
];
const steps = [
  { title: 'Send us your pieces', text: 'Tell us what you have. We review it and confirm what we can list.' },
  { title: 'We do the work', text: 'We photograph, price, and list your items where buyers are already shopping.' },
  { title: 'You get paid', text: 'When a piece sells, you earn your share.' },
];
---
<Base title="RePeak Consignment | Sustainable online consignment in Denver, CO">
  <div class="hero">
    <div class="wrap grid">
      <div>
        <p class="eyebrow">Online consignment · Denver, CO</p>
        <h1>Your wardrobe deserves a second peak.</h1>
        <p class="lead">We help pre-loved apparel, shoes, and accessories reach a wider audience than brick &amp; mortar ever could.</p>
        <div class="actions">
          <a class="btn" href="#shop">Shop our closets</a>
          <a class="btn btn-ghost" href="/consign-with-us/">Consign with us</a>
        </div>
      </div>
      <div class="hero-photo" role="img" aria-label="Pre-loved clothing on a rack"></div>
    </div>
    <Ridge />
  </div>

  <section id="shop" class="dark">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Shop</p>
        <h2>Find your next favorite piece</h2>
        <p class="lead">Browse our newest arrivals on the apps you already use.</p>
      </div>
      <ul class="tiles">
        {shops.map((s) => (
          <li><a href={s.href} aria-label={`Shop on ${s.name}`}><span class="name">{s.name}</span><span class="go">Shop now →</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Consign</p>
        <h2>Clear your closet. We'll handle the climb.</h2>
      </div>
      <!-- TODO: confirm process and commission details -->
      <ol class="steps">
        {steps.map((s) => <li><h3>{s.title}</h3><p>{s.text}</p></li>)}
      </ol>
      <div class="actions"><a class="btn" href="/consign-with-us/">Start consigning</a></div>
    </div>
  </section>

  <section class="tint">
    <div class="wrap split">
      <div class="photo" role="img" aria-label="Clothing on a rack"></div>
      <div>
        <p class="eyebrow">Our purpose</p>
        <h2>Give great clothes a second life.</h2>
        <p class="lead">We make sustainable fashion affordable and accessible, celebrating the stories pre-loved pieces carry with them.</p>
        <div class="actions"><a class="btn btn-ghost" href="/about/">Our story</a></div>
      </div>
    </div>
  </section>
</Base>
