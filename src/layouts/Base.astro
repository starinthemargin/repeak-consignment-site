---
import '@fontsource-variable/inter';
import '@fontsource-variable/fraunces';
import '../styles/global.css';
import Ridge from '../components/Ridge.astro';
interface Props { title: string; description?: string }
const { title, description = 'Online consignment based in Denver, CO. Sustainable, pre-loved fashion with a second peak.' } = Astro.props;
const path = Astro.url.pathname;
const platforms = [
  { href: 'https://poshmark.com/closet/repeakconsign', label: 'Poshmark' },
  { href: 'https://www.mercari.com/u/repeakconsignment/', label: 'Mercari' },
  { href: 'https://www.depop.com/repeakconsignment/', label: 'Depop' },
];
const links = [
  { href: '/#shop', label: 'Shop' },
  { href: '/consign-with-us/', label: 'Consign' },
  { href: '/about/', label: 'About' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title}</title>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-GS68MH404B"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-GS68MH404B');
    </script>
  </head>
  <body>
    <header class="site">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="RePeak Consignment home"><img src="/logo-green.png" alt="RePeak Consignment" width="160" height="153" /></a>
        <nav aria-label="Main">
          {links.map((l) => <a href={l.href} aria-current={path === l.href ? 'page' : undefined}>{l.label}</a>)}
          <a class="btn btn-sm" href="/consign-with-us/">Consign with us</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site">
      <Ridge flip />
      <div class="wrap foot">
        <div>
          <img src="/logo-white.png" alt="RePeak Consignment" width="120" height="115" />
          <p>Online consignment · Denver, CO</p>
        </div>
        <div>
          <h2>Shop</h2>
          <ul>{platforms.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </div>
        <div>
          <h2>Explore</h2>
          <ul>
            <li><a href="/consign-with-us/">Consign with us</a></li>
            <li><a href="/brands/">Brands we love</a></li>
            <li><a href="/about/">About</a></li>
          </ul>
        </div>
      </div>
      <p class="wrap legal">&copy; {new Date().getFullYear()} RePeak Consignment</p>
    </footer>
  </body>
</html>
